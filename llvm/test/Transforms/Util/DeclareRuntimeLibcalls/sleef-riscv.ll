; RVV fmod has two vector arguments and no mask. The multi-result functions
; require a different ABI and must remain unavailable until it is supported.
; The vector library selection must not enable functions for another target,
; and the RVV functions must not enter the default system runtime library.
;
; Generate checks directly from declarations: update_test_checks.py only
; handles function definitions and global assignments.

;--- input.ll
; Empty module: all checked declarations must be supplied by the pass.

;--- gen
python3 - <<'PYGEN'
runs = [
    ("RV64", ["-mtriple=riscv64-unknown-linux-gnu", "-mattr=+v", "-vector-library=sleefgnuabi"], r"@Sleef_"),
    ("NONE", ["-mtriple=riscv32-unknown-linux-gnu", "-mattr=+v", "-vector-library=sleefgnuabi"], r"@fmod\("),
    ("NONE", ["-mtriple=x86_64-unknown-linux-gnu", "-vector-library=sleefgnuabi"], r"@fmod\("),
    ("NONE", ["-mtriple=riscv64-unknown-linux-gnu", "-mattr=+v", "-vector-library=none"], r"@fmod\("),
]
import re
import subprocess

seen = {}
for prefix, flags, name_re in runs:
    ir = subprocess.check_output(
        ["opt", "-S", "-passes=declare-runtime-libcalls", *flags, "input.ll"],
        text=True,
    )
    declarations = [
        line for line in ir.splitlines()
        if line.startswith("declare ") and re.search(name_re, line)
    ]
    assert declarations, (prefix, flags)
    if prefix in seen:
        assert declarations == seen[prefix], (prefix, declarations)
        continue
    seen[prefix] = declarations
    attrs = set()
    print(";")
    for line in declarations:
        match = re.search(r"#([0-9]+)$", line)
        if match:
            number = match[1]
            variable = "ATTR" + number
            replacement = "[[" + variable
            if number not in attrs:
                replacement += ":#[0-9]+"
                attrs.add(number)
            line = line[:match.start()] + replacement + "]]"
        print("; " + prefix + ": " + line)
    for line in ir.splitlines():
        match = re.match(r"attributes #([0-9]+) = ", line)
        if match and match[1] in attrs:
            line = "attributes [[ATTR" + match[1] + "]] = " + line[match.end():]
            print("; " + prefix + ": " + line)
PYGEN

