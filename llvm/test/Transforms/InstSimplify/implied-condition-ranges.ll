; SIMPLIFY-NEXT:    [[SUM:%.*]] = add i8 [[SIZE:%.*]], [[OFFSET:%.*]]
; SIMPLIFY-NEXT:    [[SUM_LARGE:%.*]] = icmp ugt i8 [[SUM]], [[LIMIT:%.*]]
